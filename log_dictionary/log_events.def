EVENT(CANHandlerRX_NO_ACT_CALLBACK_FAIL, 1005, 1, "[WARN] [CAN Handler RX] Callback failed for Act Cmd with Act ID: %d.")
EVENT(CANHandler_TX_QUEUE_FAIL, 1009, 0, "[WARN] [CAN Handler TX] Failed to queue message for TX. Queue full?")
EVENT(CANHandlerRX_CALLBACK_MSG_TYPE_FAIL, 1010, 1, "[WARN] [CAN Handler RX] Callback failed for msg type %d.")
EVENT(CANHandlerRX_MSG_TIMEOUT, 1011, 0, "[WARN] [CAN Handler RX] Timed out waiting for RX message.")
EVENT(CAN_TX_SEND_FAIL, 1012, 0, "[WARN] [CAN TX] CAN send failed!")
EVENT(CANHandlerTX_NO_QUEUE_MSG, 1013, 0, "[WARN] [CAN Handler TX] no tx msg in queue")

