/*
* events.def
*
* Defines every event the program can log.
*
* Each entry has the form:
*   EVENT(enum_name, event_id, num_args, message)
*
*   enum_name  Identifier used in code (e.g. SENSOR_TIMEOUT) <- Note: A LOG_EVENTS prefix will be automatically added to the enum name
*   event_id   32-bit ID, described below
*   num_args   Number of format arguments the message takes
*   message    printf-style message string
*
* event_id layout (16-bit number):
*
*     0x  SS CCC
*         |  |
*         |  +-- Event code (3 digits): identifies the specific event
*         |    
*         +---------- File/Source ID (2 digits): subsystem that emitted the event
*
*
* Example: 1001
*   Source = 01 Code = 001
*
* Note: Error Codes cannot starting with leading 0's or else C will compile it incorrectly.
*/

/* ==========================================================================
* can_handler.c            source_id = 001
* ===========================================================================
*/

/* --- FATAL (severity 1) --- */
EVENT(CAN_INITQ_FAIL, 1006, 0, "[FATAL] [CAN] initfailq")
EVENT(CANHandler_INIT_STM_FAIL, 1007, 0, "[FATAL] [CAN Handler] can_init_stm failed.")
EVENT(CANHandler_CALLBACK_REGISTER_FAIL, 1008, 0, "[FATAL] [CAN Handler] Failed to register mandatory CAN callbacks.")

/* --- WARN (severity 2) --- */
EVENT(CANCallback_READ_FAIL, 1001, 0, "[WARN] [CAN Callback] Failed to read board reset.")
EVENT(CANCallback_LED_ON_FAIL, 1002, 0, "[WARN] [CAN Callback] LED ON callback failed to set GPIO.")
EVENT(CANCallback_LED_OFF_FAIL, 1003, 0, "[WARN] [CAN Callback] LED OFF callback failed to set GPIO.")
EVENT(CANHandlerRX_NO_ACT_ID, 1004, 0, "[WARN] [CAN Handler RX] Can't get the actuator id.")
EVENT(CANHandlerRX_NO_ACT_CALLBACK_FAIL, 1005, 1, "[WARN] [CAN Handler RX] Callback failed for Act Cmd with Act ID: %d.")
EVENT(CANHandler_TX_QUEUE_FAIL, 1009, 0, "[WARN] [CAN Handler TX] Failed to queue message for TX. Queue full?")
EVENT(CANHandlerRX_CALLBACK_MSG_TYPE_FAIL, 1010, 1, "[WARN] [CAN Handler RX] Callback failed for msg type %d.")
EVENT(CANHandlerRX_MSG_TIMEOUT, 1011, 0, "[WARN] [CAN Handler RX] Timed out waiting for RX message.")
EVENT(CAN_TX_SEND_FAIL, 1012, 0, "[WARN] [CAN TX] CAN send failed!")
EVENT(CANHandlerTX_NO_QUEUE_MSG, 1013, 0, "[WARN] [CAN Handler TX] no tx msg in queue!")

/* --- INFO (severity 3) --- */

/* --- DEBUG (severity 4) --- */

