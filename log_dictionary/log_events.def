/*
* events.def
*
* Defines every event the program can log.
*
* Each entry has the form:
*   EVENT(enum_name, event_id, num_args, message)
*
*   enum_name  Identifier used in code (e.g. EVT_SENSOR_TIMEOUT)
*   event_id   32-bit ID, described below
*   num_args   Number of format arguments the message takes
*   message    printf-style message string
*
* event_id layout (8 hex digits = 32 bits):
*
*     0x  SSS  V  CCCC
*         |    |  |
*         |    |  +-- Event code (4 digits): identifies the specific event
*         |    +----- Severity (1 digit): see table below
*         +---------- File/Source ID (3 digits): subsystem that emitted the event
*
* Severity values:
*   1 = FATAL  Errors (non-recoverable)
*   2 = WARN   Warnings (recoverable issues)
*   3 = INFO   Info (data from sensors, etc)
*   4 = DEBUG  Only for debugging on the ground
*
* Example: 0x00220007
*   Source = 0x002, Severity = 2 (WARN), Code = 0x0007
*/

/* ==========================================================================
* can_handler.c            source_id = 001
* ===========================================================================
*/

/* --- FATAL (severity 1) --- */

/* --- WARN (severity 2) --- */
EVENT(CAN_CALLBACK, 0x00120001, 0, "Failed to read board reset.")

/* --- INFO (severity 3) --- */

/* --- DEBUG (severity 4) --- */

